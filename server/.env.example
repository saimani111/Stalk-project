PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=replace-with-a-long-random-string

# Password-reset emails (Gmail app password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# AI providers (all optional; priority: gemini > groq > openai > free pollinations)
GEMINI_API_KEY=            # NOTE: new AQ.-format keys are rejected by the REST API (Google migration issue) — needs an AIza key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=              # free, works today: https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=150         # per-user Stuny chats per day

# Stuny voice clone (optional; browser TTS is used when unset)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
